{
  "name": "sendi-api",
  "version": "3.0.2",
  "type": "module",
  "description": "SDK officiel pour l'API Sendi - Livraison en Afrique",
  "main": "dist/sendi-api.cjs.js",
  "module": "dist/sendi-api.esm.js",
  "browser": "dist/sendi-api.umd.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/sendi-api.esm.js",
      "require": "./dist/sendi-api.cjs.js",
      "default": "./dist/sendi-api.esm.js"
    },
    "./orders": {
      "types": "./types/resources/orders.d.ts",
      "import": "./src/resources/orders.js",
      "require": "./dist/sendi-api.cjs.js"
    },
    "./commercant": {
      "types": "./types/resources/commercant.d.ts",
      "import": "./src/resources/commercant.js",
      "require": "./dist/sendi-api.cjs.js"
    },
    "./agence": {
      "types": "./types/resources/agence.d.ts",
      "import": "./src/resources/agence.js",
      "require": "./dist/sendi-api.cjs.js"
    },
    "./delivery": {
      "types": "./types/resources/delivery.d.ts",
      "import": "./src/resources/delivery.js",
      "require": "./dist/sendi-api.cjs.js"
    },
    "./stats": {
      "types": "./types/resources/stats.d.ts",
      "import": "./src/resources/stats.js",
      "require": "./dist/sendi-api.cjs.js"
    },
    "./webhook": {
      "types": "./types/resources/webhook.d.ts",
      "import": "./src/resources/webhook.js",
      "require": "./dist/sendi-api.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "npm run build:clean && node scripts/build.js && rollup -c",
    "build:clean": "rm -rf dist",
    "build:types": "tsc --emitDeclarationOnly",
    "prepublishOnly": "npm run test && npm run build && npm run build:types",
    "dev": "nodemon --exec node examples/basic.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js examples/**/*.js",
    "security": "npm audit --audit-level=high"
  },
  "keywords": [
    "sendi",
    "api",
    "delivery",
    "africa",
    "livraison",
    "sdk",
    "logistics",
    "cote-divoire",
    "senegal",
    "cameroon",
    "marketplace",
    "ecommerce",
    "shipping",
    "livraison-afrique",
    "api-livraison"
  ],
  "author": {
    "name": "Sendi API Team",
    "email": "support@sendi.com",
    "url": "https://sendi.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmmanuelJessy/sdk-sendi.git"
  },
  "homepage": "https://github.com/EmmanuelJessy/sdk-sendi#readme",
  "bugs": {
    "url": "https://github.com/EmmanuelJessy/sdk-sendi/issues"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.0.0",
    "rollup": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
